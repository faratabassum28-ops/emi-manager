# MongoDB connection (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/emi_manager
PORT=5000

# REQUIRED in production: a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me

# Only needed if the React app is hosted on a different domain than the API (comma-separated)
# CLIENT_ORIGIN=https://emi.example.com

# Where payment screenshots / agreements are stored. Must be a PERSISTENT disk in production.
# UPLOAD_DIR=/var/data/emi-uploads

# First admin created by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
